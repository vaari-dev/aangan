    <!-- The Home-button service's disclosure, shown before Android's accessibility settings -->
    <string name="disclosure_title">Open Aangan with the Home button</string>
    <string name="disclosure_body">Aangan uses Android\'s accessibility service for one thing: when you press Home, or the TV\'s own home screen appears, it opens Aangan instead.\n\nIt reacts to the Home button only; every other button passes straight through. It can\'t see what\'s on screen or what you watch, and it stores and sends nothing.\n\nNext, choose Aangan and switch it on. You can switch it off there any time.</string>
    <string name="disclosure_agree">Agree and continue</string>

