<?xml version="1.0" encoding="utf-8"?>
<!-- The Home button, and window events only from the TVs' own home screens (Google TV, Android TV,
     Xiaomi PatchWall). No access to window content. Other buttons pass through untouched. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher,com.mitv.tvhome"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:description="@string/home_button_description" />
