    <!-- The Home-button service's disclosure -->
    <string name="disclosure_title">होम बटन से आँगन खोलें</string>
    <string name="disclosure_body">आँगन Android की सुलभता (accessibility) सेवा का इस्तेमाल सिर्फ़ एक काम के लिए करता है: जब आप होम दबाते हैं, या टीवी की अपनी होम स्क्रीन आती है, तो यह उसकी जगह आँगन खोलता है।\n\nयह केवल होम बटन पर काम करता है; बाकी हर बटन पहले की तरह चलता है। यह न स्क्रीन पर कुछ देख सकता है, न यह कि आप क्या देखते हैं, और यह कुछ भी सहेजता या भेजता नहीं है।\n\nअगले चरण में Aangan चुनें और उसे चालू करें। आप उसे वहीं कभी भी बंद कर सकते हैं।</string>
    <string name="disclosure_agree">सहमत हूँ, आगे बढ़ें</string>

