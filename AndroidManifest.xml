<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.vaari.aangan">

    <!-- Network use is limited to: weather and air quality from Open-Meteo (the city's coordinates,
         no identifiers, only while the home screen is on show); city search when you ask for it; and
         the phone-setup page, served on the home network only while Settings is open. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To find the TV's address on the home network for the phone-setup QR code. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A TV app: Google Play offers it to TVs only. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility (Android 11+): only apps that can be launched. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- To tell whether pressing Home already brings up Aangan. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Crash keeps a note on the TV if Aangan crashes; nothing is ever sent. -->
    <application
        android:name=".Crash"
        android:label="Aangan"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Aangan">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- LEANBACK_LAUNCHER puts Aangan in the TV's own app list, so it can be opened after installing. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".CityActivity"
            android:exported="false"
            android:label="Your city"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="Aangan settings"
            android:screenOrientation="landscape" />

        <service
            android:name=".HomeButton"
            android:exported="true"
            android:label="Aangan"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button" />
        </service>

        <service
            android:name=".ClockDream"
            android:exported="true"
            android:label="Aangan clock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
